# Salin file ini menjadi ".env" lalu isi sesuai kebutuhan.
# JANGAN commit file ".env" ke Git — hanya ".env.example" ini yang boleh.

# ---- Tahap 1 (aktif sekarang) ----
APP_ENV=local
DEFAULT_WATCHLIST=BBCA.JK,BBRI.JK,TLKM.JK,AAPL,MSFT,BTC-USD
CACHE_TTL_SECONDS=60
NEWS_MAX_ITEMS=8

