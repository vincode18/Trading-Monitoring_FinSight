APP_ENV=local
CORS_ORIGINS=http://localhost:3000
DEFAULT_WATCHLIST=BBCA.JK,BBRI.JK,TLKM.JK,AAPL,MSFT,BTC-USD
CACHE_TTL_SECONDS=60
NEWS_MAX_ITEMS=8

# --- Database (Supabase + Prisma) ---
# Runtime (transaction pooler, port 6543) — tambah ?pgbouncer=true untuk Prisma
DATABASE_URL=postgresql://postgres.kcizqggwxwocyomisgjh:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrasi Prisma (session pooler, port 5432)
DIRECT_URL=postgresql://postgres.kcizqggwxwocyomisgjh:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Jangan commit nilai asli — isi hanya di .env lokal / secret manager
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440
